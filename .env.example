# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/samad_hardware"

# Long random string used to sign admin session tokens.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# Public URL of the website (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Used only by `npm run admin:create` (initial owner account setup).
# Leave blank in production; the script will prompt instead.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""

# Cloudinary (optional, for product image uploads in production)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Folder for locally stored product images when Cloudinary is NOT configured.
# Must be a persistent disk. Do not rely on this on serverless hosts such as Vercel.
# UPLOAD_DIR=""

# Max database connections per server instance (default 5 in production, 10 in development).
# Lower it if your database plan has a small connection limit.
# DB_POOL_MAX="5"
